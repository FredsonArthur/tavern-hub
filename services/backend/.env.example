# Django
DJANGO_SECRET_KEY=exemplo-chave-secreta-mude-em-producao
DJANGO_DEBUG=True

# Banco de Dados (PostgreSQL em produção, SQLite em de
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/tavernhub

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=cronicas_rolagem

# Opcional: URL completa para o consumer Node.js
RABBITMQ_URL=amqp://guest:guest@localhost:5672
